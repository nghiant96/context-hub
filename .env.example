# Copy to .env (never committed) and fill in.
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# One token serves Jira and Confluence. It acts as you: the index only sees
# the tickets and pages you can see.
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
# JIRA_BASE_URL=https://onemount.atlassian.net   # overrides context-hub.config.json
