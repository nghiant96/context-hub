{
  "name": "context-hub",
  "version": "0.2.1",
  "private": true,
  "description": "Ngữ cảnh nghiệp vụ dùng chung cho BA, dev, QC: index Jira, Confluence và lịch sử git vào SQLite, phục vụ AI qua MCP.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ctx": "./src/cli.ts"
  },
  "scripts": {
    "ctx": "node src/cli.ts",
    "mcp": "node src/mcp.ts",
    "build:extension": "node scripts/build-extension.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
